# Google Cloud (Vertex AI / Gemini)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=asia-northeast1
GEMINI_API_KEY=your-gemini-api-key

# Firebase (Authentication & Firestore)
# Cloud Run上ではアタッチしたサービスアカウントのADCが自動適用されるため未設定でよい。
# ローカル開発では `gcloud auth application-default login` を実行するか、
# GOOGLE_APPLICATION_CREDENTIALS にサービスアカウントキーのパスを設定する。
# FIREBASE_WEB_API_KEY は Firebase コンソール > プロジェクトの設定 > 全般 > ウェブAPIキー から取得
# （パスワードログイン時の検証にIdentity Toolkit REST APIを使うため必須）
FIREBASE_WEB_API_KEY=your-firebase-web-api-key
AUTH_SECRET_KEY=change-me-to-a-random-secret

# GMI Cloud
GMI_API_KEY=your-gmi-api-key
GMI_BASE_URL=https://api.gmi-cloud.com/v1

# 駅すぱあと (Val Laboratory)
EKISPERT_API_KEY=your-ekispert-key

# YouCam API
YOUCAM_API_KEY=your-youcam-key
YOUCAM_PUBLIC_KEY=your-youcam-rsa-public-key

# SNSシェア機能（疑似市民の声のX.com / Blueskyシェア、social_posting.py）
# 専用botアカウントは使わない。以下はサーバー側の共通設定のみで、
# 実際に投稿するユーザー本人のトークン/app passwordはリクエストの都度
# クライアント（フロントエンド）から渡され、サーバーには保存されない。
#
# Bluesky: 動作確認用にサーバー側でも直接ログインしたい場合のみ設定する
# （本番のユーザー投稿フローでは不要。app passwordは
#  https://bsky.app/settings/app-passwords で発行し、アカウント本パスワードは使わない）
BSKY_HANDLE=your-handle.bsky.social
BSKY_APP_PASSWORD=your-bluesky-app-password
#
# X (Twitter): OAuth 1.0a User Contextでユーザー自身の投稿を行うために必要な
# アプリ資格情報。X Developer Portal (https://developer.x.com/en/portal/dashboard)
# でアプリを作成し、Consumer Key/Secretを取得する。無料枠(Free tier)は
# 投稿数・機能に制限があるため、本番運用前にAPI tierを確認すること。
X_CONSUMER_KEY=your-x-consumer-key
X_CONSUMER_SECRET=your-x-consumer-secret


# Port
PORT=8080
